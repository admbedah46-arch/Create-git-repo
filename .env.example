# Multi-Backend Hybrid Environment Variables (SiMANTAP Bedah)

# 1. Firebase Multi-Database Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. Supabase Credentials (Core Auth & Primary Relational DB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Cloudflare D1 Worker API (High-Traffic Read-Heavy API)
VITE_CLOUDFLARE_D1_URL=

# 4. PocketBase Storage Service (File & Attachment Upload)
VITE_POCKETBASE_URL=

# 5. Google Apps Script Web App Endpoint (Export, Reports & Live Spreadsheet)
VITE_GAS_URL=
VITE_APPS_SCRIPT_URL=

# Gemini API Key (Server-side AI)
GEMINI_API_KEY=

